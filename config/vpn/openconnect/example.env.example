# Copy to `<profile>.env` and keep the password outside dotfiles.
VPN_NAME="work"
VPN_HOST="vpn.example.com"
VPN_USER="username"
VPN_AUTHGROUP=""
VPN_SERVERCERT=""
VPN_PASSWORD_FILE="$HOME/.local/secrets/work-vpn.pass"

# Optional raw openconnect arguments, for example:
# VPN_EXTRA_ARGS="--protocol=gp"
