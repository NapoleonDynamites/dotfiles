layout {
    cwd "/home/iar/dotfiles"

    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }

    tab name="dotfiles" focus=true {
        pane command="nvim" focus=true {
            args "."
        }
    }

    tab name="git" split_direction="vertical" {
        pane command="bash" name="status" size="35%" {
            args "-lc" "git status --short; exec zsh"
        }
        pane name="shell"
    }

    tab name="hypr" split_direction="vertical" {
        pane command="nvim" name="hyprland" {
            args "config/hypr/hyprland.lua"
        }
        pane command="nvim" name="idle-lock" size="40%" {
            args "config/hypr/hypridle.conf"
        }
    }

    tab name="shell" split_direction="vertical" {
        pane name="main"
        pane name="side" size="35%"
    }
}
