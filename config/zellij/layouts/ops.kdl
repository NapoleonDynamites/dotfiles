layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }

    tab name="monitor" focus=true split_direction="vertical" {
        pane command="btop" name="btop" size="65%"
        pane name="shell"
    }

    tab name="network" split_direction="vertical" {
        pane command="bash" name="ip" size="45%" {
            args "-lc" "ip -brief address; exec zsh"
        }
        pane name="shell"
    }

    tab name="logs" split_direction="vertical" {
        pane command="bash" name="journal" {
            args "-lc" "journalctl --user -f"
        }
        pane name="shell" size="35%"
    }
}
